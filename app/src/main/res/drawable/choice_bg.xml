<?xml version="1.0" encoding="utf-8"?>
<!-- 0.6.65: one segment of a ChoiceStrip: square, no border of its own (the strip draws the one outline and the dividers), filled when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/choice_off_bg_disabled" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/choice_on_bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/choice_off_bg" />
        </shape>
    </item>
</selector>
