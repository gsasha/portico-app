<?xml version="1.0" encoding="utf-8"?>
<!-- 0.6.65: the one 1dp outline around a whole ChoiceStrip. Square corners: no rounding anywhere. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/choice_stroke_disabled" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/choice_stroke" />
        </shape>
    </item>
</selector>
