<?xml version="1.0" encoding="utf-8"?>
<!--
  PR-C2: the QR scanner. A viewfinder, not a page: the picture fills the screen, the aiming
  square is drawn over it (ScanReticleView, Viewfinder.aimingSquare), one short instruction sits
  at the top and the state plus the way out at the bottom. Nothing grows with input, so it fits
  rather than scrolls; the two bars are wrap_content overlays and the square is placed by the
  same arithmetic that rendering checked at 1080x2400 (docs/architecture/qr-scanner.md, PR-C2).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <TextureView
        android:id="@+id/scan_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.meda.portico.setup.ScanReticleView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/scan_aim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_horizontal"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:text="@string/scan_aim"
        android:textColor="#ffffff"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:text="@string/scan_starting"
            android:textColor="#ffffff"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="@string/scan_checked_note"
            android:textColor="#ccffffff"
            android:textSize="12sp" />

        <Button
            android:id="@+id/scan_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/scan_cancel" />
    </LinearLayout>
</FrameLayout>
