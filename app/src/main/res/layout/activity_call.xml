<?xml version="1.0" encoding="utf-8"?>
<!--
  The in-call screen. It scrolls (memory every-growable-screen-must-scroll): an error message can
  wrap to many lines at a large font scale. Hang up comes before everything that can grow, so it is
  above the fold on a small phone. Never setBackgroundColor on anything here: no video surface.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- DEV-807 Panel mode only (gone otherwise): a large "Microphone is open" banner with its own Hang up, for the whole call. -->
        <LinearLayout
            android:id="@+id/call_mic_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/call_mic_banner_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/panel_mic_open"
                android:textColor="@color/panel_mic_banner_text"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/call_mic_banner_hangup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="72dp"
                android:text="@string/call_hangup" />
        </LinearLayout>

        <TextView
            android:id="@+id/call_door"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/call_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/call_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="32sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/call_hangup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="72dp"
            android:text="@string/call_hangup" />

        <Button
            android:id="@+id/call_mute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="@string/call_mute"
            android:visibility="gone" />

        <!-- the owner 2026-11-21: shown while the phone is locked; asks the system for the unlock (face, fingerprint or PIN). The call goes on. -->
        <Button
            android:id="@+id/call_unlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/call_unlock_hint"
            android:minHeight="64dp"
            android:text="@string/call_unlock"
            android:visibility="gone" />

        <include layout="@layout/view_audio_controls" />

        <!-- M7 H2 (gated off, every view below is gone unless a call is held): one quiet line (a held call ended, or another
             app has the audio), then the switcher strip for the held call, then its own End button. The strip is ONE
             TalkBack node (its contentDescription is set in code); its children are hidden from accessibility, so the
             Switch button inside it is only the picture of what a double tap on the strip does. -->
        <TextView
            android:id="@+id/call_hold_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/call_held_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:contentDescription="@string/call_held_strip_default"
            android:focusable="true"
            android:importantForAccessibility="noHideDescendants"
            android:minHeight="72dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_hold_pause" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/call_held_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/call_held_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/call_held_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/call_held_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:text="@string/call_switch" />
        </LinearLayout>

        <Button
            android:id="@+id/call_held_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/call_end_held"
            android:visibility="gone" />

        <!-- A2: the caller's camera stills and its custom call buttons (the document's `callers` entry for this door),
             built in code, below Hang up and Mute so those stay above the fold. Never setBackgroundColor on a video
             surface: these are ImageViews. -->
        <LinearLayout
            android:id="@+id/call_stills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/call_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/call_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/call_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="72dp"
            android:text="@string/call_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/call_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="@string/call_open_settings"
            android:visibility="gone" />

        <Button
            android:id="@+id/call_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="64dp"
            android:text="@string/call_close"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
