<?xml version="1.0" encoding="utf-8"?>
<!--
  0.6.75: the call window, the incoming-call screen of a door call (Android's dialer look). Top: who is calling; middle: the Ring page's
  content (cameras and buttons, built in code, scrolls); bottom: the call controls as round buttons. The middle scrolls (every growable
  screen must), the top and the bottom never do, so Answer and Decline are always on screen. The background is on the ROOT only, never on
  a camera tile (a SurfaceView with a background hides its video).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/cw_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cw_label"
            android:textColor="#FF9CA3AF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/cw_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cw_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textColor="#FFD1D5DB"
            android:textSize="18sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/cw_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/cw_stills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cw_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/cw_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFD1D5DB"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- the call controls: round buttons with their word under them: Decline (left) and Answer (right). 0.6.76: the window is the ringing screen only;
         an answered call is Home's (the call bar), so there is no End call, timer or audio row here. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/cw_row_ring"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cw_decline_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/cw_decline"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/call_round_red"
                    android:contentDescription="@string/cw_decline"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mdi_phone_hangup"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/cw_decline"
                    android:textColor="#FFD1D5DB"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cw_answer_box"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/cw_answer"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/call_round_green"
                    android:contentDescription="@string/cw_answer"
                    android:padding="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mdi_phone"
                    android:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/cw_answer"
                    android:textColor="#FFD1D5DB"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/cw_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="@string/cw_close"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
